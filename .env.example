# Required in production: a long random string used to sign sandbox state (HMAC-SHA256).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STATE_SECRET=

# --- Option A (free): any OpenAI-compatible provider. Takes priority if set. ---
# Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1
# Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
# Azure / Microsoft Foundry: LLM_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1
#             LLM_MODEL = your DEPLOYMENT name (not the model family name)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Option B: Anthropic Claude API ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# With none of the above, Kuntur runs its deterministic rule-based planner.
